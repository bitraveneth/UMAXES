# UMAXES — copy to .env.local / Vercel env. Never commit real secrets.

# Postgres (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/umaxes?sslmode=require"

# Auth.js (required)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Public site URL (Vercel / production)
AUTH_URL="https://your-app.vercel.app"

# Altcha (recommended in production — falls back to a dev secret if unset)
ALTCHA_HMAC_SECRET=""

# Vercel Blob — required for durable uploads on Vercel serverless
# Create a Blob store in the Vercel dashboard and paste the token.
# Local / VPS: leave unset to write under public/uploads/
BLOB_READ_WRITE_TOKEN=""

# Optional: Twilio SMS OTP
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Optional: shipment tracking cron
CRON_SECRET=""
AFTERSHIP_API_KEY=""
TRACKING_PROVIDER=""

# Optional: outbound email
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional: geo block (middleware)
GEO_BLOCK_ENABLED=""
